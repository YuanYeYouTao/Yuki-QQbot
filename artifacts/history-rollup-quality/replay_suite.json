{
  "suite_version": "history-rollup-replay/v1",
  "notes": "Synthetic labeled replay set for structural and extractive gates. Not a Flash quality corpus. The frozen-near-window gate (short messages, coverage advances without skipping ids) runs programmatically in quality.py.",
  "cases": [
    {
      "id": "long_tech_discussion",
      "scope": "private",
      "needles": ["SQLite WAL", "Alembic 0041"],
      "events": [
        {"content": "我们要把会话摘要做成可重建的 SQLite WAL 方案。"},
        {"content": "迁移号先定 Alembic 0041，不要另开合同文档。"},
        {"content": "指纹不能带 summarizer_version，extractive 和 Flash 要同一来源键。"},
        {"content": "这样会不会更稳？"}
      ]
    },
    {
      "id": "multi_round_code_review",
      "scope": "private",
      "needles": ["list_recent(1000)", "id > coverage_end"],
      "events": [
        {"content": "这段 assembler 还在 list_recent(1000) 再丢掉前缀。"},
        {"content": "覆盖后应该只拉 id > coverage_end。"},
        {"content": "around 工具也还没接到 reply target。"},
        {"content": "第二轮：window key 要把 cov 和 rev 算进去。"}
      ]
    },
    {
      "id": "user_corrects_prior_decision",
      "scope": "private",
      "needles": ["改用 extractive", "不要先切窗"],
      "events": [
        {"content": "那就先切近窗，摘要以后再说。"},
        {"content": "不对，不要先切窗。必须先有 extractive 覆盖。"},
        {"content": "最终决定：改用 extractive 同步写入，Flash 后台升级。"}
      ]
    },
    {
      "id": "contradictory_statements",
      "scope": "private",
      "needles": ["周一有空", "周一没空"],
      "events": [
        {"content": "我周一有空，可以把发布做完。"},
        {"content": "改口了，我周一没空，只能周二。"}
      ]
    },
    {
      "id": "multi_person_group",
      "scope": "group",
      "group_id": "2001",
      "needles": ["远野", "小满", "部署窗口"],
