        {"sender": "1002", "nickname": "小满", "content": "小满觉得周五更稳。"},
        {"sender": "1003", "nickname": "阿草", "content": "那就先记争议，不要只留一个版本。"}
      ]
    },
    {
      "id": "image_visual_summary",
      "scope": "private",
      "needles": ["白板架构图", "SESSION 三路"],
