# 将本文件复制为 .env，并把所有 replace-with-* 占位符替换为真实值。
# 每个区块按功能组织；本地 .env 可使用同样的顺序和注释，切勿提交真实密钥。

# === NapCat / OneBot 连接与容器运行 ===
ONEBOT_ACCESS_TOKEN=replace-with-a-long-random-token
NAPCAT_WEBUI_TOKEN=replace-with-a-long-random-webui-token
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
NAPCAT_UID=1000
NAPCAT_GID=1000
# 可选：填写机器人 QQ 号以复用 NapCat 已缓存的账号进行快速登录。
NAPCAT_ACCOUNT=

# === 身份、准入与命令前缀 ===
SUPERUSERS=replace-with-superuser-qq
# 1.0 所有私聊默认开放；该变量仅为旧配置兼容保留。
ENABLED_GROUPS=
IGNORED_BOT_USERS=
AI_PREFIX=!ai

# === 主聊天模型与系统提示词 ===
LLM_PROVIDER=openai
LLM_BASE_URL=https://replace-with-provider.example/v1
LLM_API_KEY=replace-with-api-key
LLM_MODEL=replace-with-model-name
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=8192
# Optional explicit task routing. Copy config/model_profiles.example.toml first.
# MODEL_PROFILES_FILE=config/model_profiles.toml
# LLM_FLASH_BASE_URL=https://replace-with-provider.example/v1
# LLM_FLASH_API_KEY=replace-with-api-key
# LLM_FLASH_MODEL=replace-with-fast-model-name
MODEL_STATS_RECENT_ERROR_LIMIT=5
# DeepSeek 可设置为 false 以关闭默认思考模式；其他供应商可不填写此项。
# LLM_THINKING_ENABLED=false
# DeepSeek V4 支持 high / max；仅在思考模式开启时发送。
LLM_REASONING_EFFORT=high
SYSTEM_PROMPT=你是一个 QQ AI 助手。只输出最终回答，不输出隐藏推理过程。
# 长提示词推荐复制 config/system_prompt.example.md，并取消下一行注释。
# SYSTEM_PROMPT_FILE=config/system_prompt.md
BOT_DISPLAY_NAME=Yuki
BOT_ALIASES=Yuki,yuki,由纪
BOT_VOICE_NAME=ゆき
BOT_PERSONA_FILE=config/persona.md
# 旧部署兼容项；新部署不需要同时设置。
# YUKI_PERSONA_FILE=config/yuki_persona_core.md

# === 应用日志、限流、消息拆分与上下文 ===
LOG_LEVEL=INFO
LOG_MESSAGE_CONTENT=false
# 主 Agent 的人物/群记忆与连续聊天历史预算；48000 字符约为 12K Token 动态上下文。
# 不包含固定系统提示、工具 Schema 和工具结果；达到高水位后按下方比例成块淘汰最旧历史。
MAX_CONTEXT_CHARACTERS=12000
CONTEXT_METADATA_BUDGET_RATIO=0.55
HISTORY_WINDOW_LOW_WATERMARK_RATIO=0.67
GLOBAL_LLM_CONCURRENCY=4
PER_USER_REQUESTS_PER_MINUTE=10
PER_GROUP_REQUESTS_PER_MINUTE=30
MAX_INPUT_CHARACTERS=4000
MAX_OUTPUT_CHARACTERS=12000
MAX_QQ_MESSAGE_CHARS=1800
DAILY_CHAT_MESSAGE_DELAY_MIN_SECONDS=1
DAILY_CHAT_MESSAGE_DELAY_MAX_SECONDS=2
OBSERVE_ENABLED_GROUPS=true
RECENT_HISTORY_TOOL_LIMIT=20
LOCAL_CONTEXT_EVENT_LIMIT=1000
MEMORY_MAX_REFERENCED_TARGETS=5

# === Memory V2：提炼、检索与容量 ===
# 实时 Memory V2 处理新入站真人消息；历史账本重建必须由超级管理员显式启动。
# 三个上限分别对应 person、group、person_group active facts。
PERSON_MEMORY_MAX_ENTRIES=100
GROUP_MEMORY_MAX_ENTRIES=100
PERSON_GROUP_MEMORY_MAX_ENTRIES=50
PREFERENCE_MAX_ENTRIES=30
# 同一群/私聊按 12 条、8000 字符或最老等待 300 秒触发一次批量提取。
MEMORY_BATCH_SECONDS=30
MEMORY_BATCH_TRIGGER_COUNT=12
MEMORY_BATCH_MAX_EVENTS=12
MEMORY_BATCH_MAX_CHARACTERS=8000
MEMORY_BATCH_MAX_WAIT_SECONDS=300
MEMORY_BATCH_MAX_OUTPUT_TOKENS=4096
# Memory V2 词法检索：先在当前 QQ/群作用域内硬过滤，再使用 SQLite FTS5。
MEMORY_RETRIEVAL_ENABLED=true
SELF_MEMORY_ENABLED=true
MEMORY_SELF_REFLECTION_ENABLED=true
MEMORY_SELF_REFLECTION_SCHEDULE_HOURS=4,12,20
MEMORY_SELF_REFLECTION_TIMEZONE=Asia/Shanghai
MEMORY_SELF_REFLECTION_POLL_SECONDS=60
MEMORY_SELF_REFLECTION_MAX_BATCHES_PER_RUN=12
MEMORY_SELF_REFLECTION_MAX_BATCHES_PER_CONVERSATION_PER_RUN=7
MEMORY_SELF_REFLECTION_MAX_DAILY_CALLS=36
MEMORY_SELF_REFLECTION_EVENT_THRESHOLD=50
MEMORY_SELF_REFLECTION_CHARACTER_THRESHOLD=8000
MEMORY_SELF_REFLECTION_LOW_EVENT_THRESHOLD=30
MEMORY_SELF_REFLECTION_LOW_CHARACTER_THRESHOLD=4800
MEMORY_SELF_REFLECTION_NATURAL_GAP_SECONDS=300
MEMORY_SELF_REFLECTION_MAX_WAIT_SECONDS=28800
MEMORY_SELF_REFLECTION_MAX_EVENTS=100
MEMORY_SELF_REFLECTION_MAX_CHARACTERS=8000
MEMORY_SELF_REFLECTION_MAX_OUTPUT_TOKENS=2400
MEMORY_SELF_REFLECTION_TOOL_RECEIPT_CHARACTERS=2000
MEMORY_SELF_REFLECTION_TOOL_RECEIPT_RETENTION_DAYS=7
MEMORY_LEXICAL_CANDIDATE_LIMIT=50
MEMORY_CONTEXT_LIMIT_PER_ENTITY=8
MEMORY_OVERVIEW_LIMIT_PER_ENTITY=20
MEMORY_ALWAYS_ON_EXPLICIT_PREFERENCE_LIMIT=3
MEMORY_QUERY_TERM_LIMIT=12
MEMORY_SHORT_QUERY_FALLBACK_ENABLED=true
# Memory V2 混合检索。Embedding 关闭或远端异常时只退回上述 FTS 路径。
MEMORY_SEMANTIC_ENABLED=true
MEMORY_SEMANTIC_CANDIDATE_LIMIT=50
MEMORY_SEMANTIC_MIN_SIMILARITY=0.35
MEMORY_HYBRID_LEXICAL_WEIGHT=1.0
MEMORY_HYBRID_SEMANTIC_WEIGHT=1.0
MEMORY_HYBRID_RRF_K=60
MEMORY_INTENT_RERANK_ENABLED=true
MEMORY_ACTIVATION_RANKING_ENABLED=true
MEMORY_USAGE_REPORTING_ENABLED=true
MEMORY_REINFORCEMENT_ENABLED=true
MEMORY_RECALL_RECEIPTS_ENABLED=true
MEMORY_ACTIVATION_HALF_LIFE_EPISODE_DAYS=14
MEMORY_ACTIVATION_HALF_LIFE_FACT_DAYS=60
MEMORY_ACTIVATION_HALF_LIFE_PREFERENCE_DAYS=120
MEMORY_ACTIVATION_HALF_LIFE_EXPLICIT_DAYS=365
MEMORY_REINFORCEMENT_ALPHA_BACKGROUND=0.05
MEMORY_REINFORCEMENT_ALPHA_CONTINUATION=0.12
MEMORY_REINFORCEMENT_ALPHA_RECALL=0.25
MEMORY_REINFORCEMENT_ALPHA_VERIFY=0.08
MEMORY_INTENT_RECENT_WINDOW_DAYS=90
MEMORY_RECALL_RECEIPT_RETENTION_DAYS=30
MEMORY_RECALL_TRACE_CANDIDATE_LIMIT=20

# Memory V2 conflict consolidation and evidence aggregation
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_CANDIDATE_LIMIT=12
MEMORY_CONSOLIDATION_MIN_RELEVANCE=0.25
MEMORY_CONSOLIDATION_MODEL_TASK=memory_consolidation
MEMORY_CONSOLIDATION_MAX_OUTPUT_TOKENS=1200
MEMORY_DREAM_ENABLED=true
MEMORY_DREAM_SCHEDULE_HOUR=5
MEMORY_DREAM_TIMEZONE=Asia/Shanghai
MEMORY_DREAM_POLL_SECONDS=60
MEMORY_DREAM_MAX_CLUSTERS_PER_RUN=12
MEMORY_DREAM_MAX_MODEL_CALLS_PER_RUN=12
MEMORY_DREAM_SIMILARITY_THRESHOLD=0.70
MEMORY_DREAM_MAX_CLUSTER_SIZE=6
MEMORY_DREAM_MAX_INPUT_CHARACTERS=24000
MEMORY_DREAM_MAX_OUTPUT_TOKENS=2400
MEMORY_DREAM_EPISODE_MAX_CHARACTERS=800
MEMORY_DREAM_EPISODE_COMPRESSION_RATIO=0.45
MEMORY_DREAM_EPISODE_HARD_COMPRESSION_RATIO=0.70
MEMORY_DREAM_EVIDENCE_PER_FACT=2
MEMORY_DREAM_EVIDENCE_EXCERPT_CHARACTERS=300
MEMORY_EVIDENCE_COMPACTION_ENABLED=true
MEMORY_EVIDENCE_COMPACTION_BATCH_SIZE=20
MEMORY_MMR_ENABLED=true
MEMORY_MMR_LAMBDA=0.75
MEMORY_MMR_CANDIDATE_POOL_SIZE=20
MEMORY_EVIDENCE_WEIGHT_EXPLICIT=1.0
MEMORY_EVIDENCE_WEIGHT_SELF=0.9
MEMORY_EVIDENCE_WEIGHT_GROUP=0.7
MEMORY_EVIDENCE_WEIGHT_THIRD_PARTY=0.55
MEMORY_EVIDENCE_WEIGHT_REBUILD=0.75
MEMORY_AUTHORITY_CAP_EXPLICIT=1.0
MEMORY_AUTHORITY_CAP_SELF=0.98
MEMORY_AUTHORITY_CAP_GROUP=0.9
MEMORY_AUTHORITY_CAP_THIRD_PARTY=0.75

# Memory V2 local lifecycle maintenance
MEMORY_MAINTENANCE_ENABLED=true
MEMORY_MAINTENANCE_INTERVAL_SECONDS=300
MEMORY_MAINTENANCE_BATCH_LIMIT=100
MEMORY_AUTOMATIC_STALE_DAYS=180
MEMORY_THIRD_PARTY_STALE_DAYS=30
MEMORY_CONTESTED_STALE_DAYS=14
MEMORY_STALE_MAX_IMPORTANCE=2
MEMORY_STALE_MAX_CONFIDENCE=0.7
# Qwen DashScope Embedding 默认关闭；Key 只允许由启动环境提供。
# 可与视觉模块使用同一 API Key，但 Embedding 必须使用 DashScope 原生 /api/v1 地址。
MEMORY_EMBEDDING_ENABLED=false
MEMORY_EMBEDDING_PROVIDER=qwen_dashscope
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=qwen3.7-text-embedding
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_OUTPUT_TYPE=dense
MEMORY_EMBEDDING_DOCUMENT_TEMPLATE_VERSION=1
MEMORY_EMBEDDING_QUERY_INSTRUCT=Retrieve personal memory facts relevant to the conversational query.
MEMORY_EMBEDDING_REQUEST_TIMEOUT_SECONDS=20
MEMORY_EMBEDDING_MAX_TEXT_CHARACTERS=4000
MEMORY_EMBEDDING_WORKER_ENABLED=true
MEMORY_EMBEDDING_WORKER_INTERVAL_SECONDS=5
MEMORY_EMBEDDING_WORKER_CLAIM_LIMIT=100
MEMORY_EMBEDDING_RETRY_ATTEMPTS=5
MEMORY_EMBEDDING_RETRY_INITIAL_SECONDS=30
MEMORY_EMBEDDING_HTTP_CONCURRENCY=2
MEMORY_EMBEDDING_QUERY_CACHE_TTL_SECONDS=600
MEMORY_EMBEDDING_QUERY_CACHE_MAX_ENTRIES=512

# Memory V2 历史重建。enabled 只开放功能，不会在升级、启动或重启时自动执行。
MEMORY_REBUILD_ENABLED=false
MEMORY_REBUILD_WORKER_INTERVAL_SECONDS=5
MEMORY_REBUILD_SCAN_BATCH_SIZE=100
MEMORY_REBUILD_EXTRACTION_CONCURRENCY=2
MEMORY_REBUILD_COMMIT_BATCH_SIZE=20
MEMORY_REBUILD_CONTEXT_EVENT_LIMIT=8
MEMORY_REBUILD_RETRY_ATTEMPTS=5
MEMORY_REBUILD_RETRY_INITIAL_SECONDS=30
MEMORY_REBUILD_REVIEW_PAGE_SIZE=20
MEMORY_REBUILD_SOURCE_EXCERPT_CHARACTERS=500
# 留空表示不增加每个 run 的全局事件上限；selection 仍必须显式给出范围或 all_events=true。
MEMORY_REBUILD_MAX_EVENTS_PER_RUN=

# Deterministic 门禁位于 config/memory_quality_gates.toml；audit/hygiene 生产数据库命令
# 必须显式传 --database-url，且不会从环境变量猜测目标库。
# 以下两个 opt-in 仅供维护者以全合成数据做非 CI 实验，不写 deterministic baseline。
MEMORY_QUALITY_REAL_MODEL_ENABLED=false
MEMORY_QUALITY_REAL_EMBEDDING_ENABLED=false

# === Agent 循环预算 ===
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_MODEL_REQUESTS=13
AGENT_TOOL_RESULT_MAX_CHARACTERS=8000

# 2.1 统一 Tool Kernel。留空的可选预算表示不额外限制。
TOOLING_MAX_PARALLEL_CALLS=8
TOOLING_SELECTED_TOOL_LIMIT=32
TOOLING_SCHEMA_TOKEN_BUDGET=12000
# TOOLING_RESULT_TOKEN_BUDGET=
# TOOLING_RESULT_ITEM_LIMIT=
TOOLING_RESULT_ARTIFACT_ENABLED=true
TOOLING_RESULT_ARTIFACT_RETENTION_SECONDS=86400

# 通用 MCP Client；仅读取 MCP_CONFIG_PATH 指定的 UTF-8 JSON 文件。
MCP_ENABLED=false
MCP_CONFIG_PATH=.mcp.json
MCP_CACHE_ENABLED=true
MCP_GATEWAY_ENABLED=true
MCP_TOOL_SELECTION_MODE=hybrid
MCP_METADATA_CACHE_TTL_SECONDS=3600
MCP_CONNECT_TIMEOUT_SECONDS=15
MCP_REQUEST_TIMEOUT_SECONDS=60
MCP_SELECTED_TOOL_LIMIT=16
MCP_SCHEMA_TOKEN_BUDGET=8000
# MCP_RESULT_TOKEN_BUDGET=
# MCP_RESULT_ITEM_LIMIT=
MCP_MAX_PARALLEL_CALLS=8
MCP_ARTIFACT_RETENTION_SECONDS=86400
# 麦当劳官方 MCP Token：从 https://open.mcd.cn/mcp 控制台申请；不要提交真实值。
MCD_MCP_TOKEN=
# Miniflux MCP Bearer Token；与同机 /opt/miniflux-stack/.env 的 MCP_AUTH_TOKEN 一致。
MINIFLUX_MCP_TOKEN=

# 1.6 Planner-first 会话。旧 AUTONOMOUS_* 仅由关闭 Planner 后的 1.5.2 兼容路径读取。
PLANNER_DIRECT_ENABLED=true
PLANNER_GROUP_ENABLED=true
PLANNER_GROUP_DEBOUNCE_SECONDS=3
PLANNER_PREFERRED_MESSAGES=3
PLANNER_TEMPERATURE=0.1
PLANNER_MAX_OUTPUT_TOKENS=512
PLANNER_TIMEOUT_SECONDS=20
PLANNER_CONFIDENCE_THRESHOLD=0.2
PLANNER_REPLY_NECESSITY_THRESHOLD=0
PLANNER_MAX_PENDING_MESSAGES=8
PLANNER_RECENT_PRESENCE_WINDOW_SECONDS=300
PLANNER_MAX_WAIT_SECONDS=60
PLANNER_INTERRUPT_AUTONOMOUS_ON_NEW_MESSAGE=true
PLANNER_RECORD_RUNS=true
REPLY_SEQUENCE_CANCEL_ON_NEW_MESSAGE=true
REPLY_PLAN_HARD_MAX_MESSAGES=10

# 本地可信代码插件。1.6 的进程内权限是 API 治理，不是恶意 Python 沙盒。
PLUGIN_SYSTEM_ENABLED=false
PLUGIN_DIRECTORY=plugins
PLUGIN_API_VERSION=1.1
# 启动期静态直达绑定；命令自身的 USER/SUPERUSER 等权限仍由 Host 校验。
# GitHub Monitor 示例：{"/github":"github-monitor:github"}
PLUGIN_DIRECT_COMMAND_BINDINGS={}
PLUGIN_HOOK_TIMEOUT_SECONDS=3
PLUGIN_START_TIMEOUT_SECONDS=10
PLUGIN_STOP_TIMEOUT_SECONDS=10
PLUGIN_MAX_PROMPT_FRAGMENT_CHARACTERS=2000
PLUGIN_MAX_PROMPT_CHARACTERS_PER_PLUGIN=4000
PLUGIN_MAX_TOTAL_PROMPT_CHARACTERS=8000
PLUGIN_BACKGROUND_TASK_LIMIT=4
PLUGIN_FAILURE_DISABLE_THRESHOLD=3
PLUGIN_HTTP_MAX_RESPONSE_BYTES=2097152
PLUGIN_HTTP_TIMEOUT_SECONDS=15
PLUGIN_EXTERNAL_EVENT_CONTEXT_LIMIT=10
PLUGIN_EXTERNAL_EVENT_CONTEXT_CHARACTERS=6000
PLUGIN_AI_SESSION_MAX_HISTORY_MESSAGES=200

# 持久化自动化。普通用户可管理自己的任务；SUPERUSERS 可额外委托管理员能力。
AUTOMATION_ENABLED=false
DEFAULT_TIMEZONE=Asia/Shanghai
AUTOMATION_POLL_SECONDS=2
AUTOMATION_LEASE_SECONDS=120
AUTOMATION_MAX_ACTIVE_PER_SUPERUSER=50
AUTOMATION_MAX_ACTIVE_PER_USER=10
AUTOMATION_MAX_STEPS=16
AUTOMATION_MAX_LLM_CALLS_PER_RUN=10
AUTOMATION_MAX_TOOL_CALLS_PER_RUN=16
AUTOMATION_MAX_MESSAGES_PER_RUN=10
AUTOMATION_MAX_RUNTIME_SECONDS=600
AUTOMATION_MIN_INTERVAL_SECONDS=60
AUTOMATION_DEFAULT_MISFIRE_GRACE_SECONDS=1800
AUTOMATION_MAX_CONSECUTIVE_FAILURES=3
AUTOMATION_RUN_RETENTION_DAYS=30

# === 好感度与信任度 ===
RELATIONSHIP_ENABLED=true
RELATIONSHIP_INITIAL_AFFECTION=50
RELATIONSHIP_INITIAL_TRUST=50
RELATIONSHIP_BATCH_SECONDS=60
RELATIONSHIP_BATCH_TRIGGER_COUNT=5
RELATIONSHIP_BATCH_MAX_TURNS=10
RELATIONSHIP_MAX_ATTEMPTS=3
RELATIONSHIP_CONFIDENCE_THRESHOLD=0.75
AFFECTION_MAX_AUTO_DELTA=2
TRUST_MAX_AUTO_DELTA=2
TRUST_AFFECTION_CAP_OFFSET=10
CONFLICT_PREFERENCE_MIN_GAP=15
# 0 表示不限制每日累计变化；也可在运行时按 global/group/user 覆盖。
RELATIONSHIP_DAILY_POSITIVE_CAP=0
RELATIONSHIP_DAILY_NEGATIVE_CAP=0

# === 可控联网搜索 ===
# 推荐使用 native；未设置 WEB_MODE 时继续兼容 WEB_ENABLED（true=tavily，false=disabled）。
WEB_MODE=native
WEB_ENABLED=false
# 仅 tavily / native_with_tavily_fallback 模式需要。
TAVILY_API_KEY=replace-with-tavily-api-key
# 混合模式下，明确 URL 命中这些域名时直接交给 Tavily；子域名也会匹配。
WEB_TAVILY_DOMAINS=github.com,raw.githubusercontent.com
# 当前用户消息只要包含 Tavily、Tavility 或塔维利，就直接选择 Tavily。
WEB_ALLOW_PROVIDER_OVERRIDE=true
WEB_FALLBACK_ON_ACCESS_DENIED=true
WEB_FALLBACK_ON_TARGET_MISS=true
WEB_SEARCH_DEPTH=advanced
WEB_SEARCH_MAX_RESULTS=5
WEB_EXTRACT_MAX_RESULTS=3
WEB_TIMEOUT_SECONDS=20
WEB_MAX_RETRIES=1
WEB_GLOBAL_CONCURRENCY=4
WEB_MAX_CALLS_PER_TURN=3
WEB_TOOL_RESULT_MAX_CHARACTERS=16000
WEB_SOURCE_RETENTION_DAYS=7
WEB_SOURCE_MAX_RUNS_PER_CONVERSATION=10

# 图片、图片表情和动态表情理解（阿里云百炼 OpenAI-compatible 接口）。
# 启用前必须填写 VISION_BASE_URL、VISION_API_KEY 和 VISION_MODEL。
VISION_ENABLED=false
VISION_PROVIDER=qwen
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=qwen3.7-plus
VISION_TIMEOUT_SECONDS=120
VISION_MAX_RETRIES=1
VISION_GLOBAL_CONCURRENCY=4
VISION_QUEUE_MAX_PENDING=32
VISION_QUEUE_TIMEOUT_SECONDS=120
VISION_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
# TUN/Fake-IP 或确需访问内网图片时可开启；开启后会解除图片 URL 的 SSRF 地址拦截。
VISION_ALLOW_PRIVATE_URLS=false
VISION_MAX_OUTPUT_TOKENS=8192
VISION_THINKING_ENABLED=false
VISION_THINKING_BUDGET=6144
VISION_LOW_CONFIDENCE_RETRY_THRESHOLD=0.65
VISION_MAX_IMAGES_PER_TURN=5
VISION_MAX_FRAMES_PER_TURN=16
VISION_GIF_MAX_FRAMES=8
VISION_MAX_DOWNLOAD_BYTES=20971520
VISION_MAX_PREPARED_BYTES=16777216
VISION_MAX_DIMENSION=4096
VISION_MAX_PIXELS=16777216
VISION_PER_USER_REQUESTS_PER_MINUTE=20
VISION_PER_GROUP_REQUESTS_PER_MINUTE=60
VISION_ANALYSIS_RETENTION_DAYS=7

# 1.7 持久化表情系统。识别复用上面的视觉 Provider，不会额外调用审核模型。
EMOJI_ENABLED=true
EMOJI_COLLECTION_ENABLED=true
EMOJI_COLLECTION_MODE=likely
EMOJI_COLLECT_PRIVATE=true
EMOJI_COLLECT_GROUP=true
EMOJI_AUTO_ADOPT_ENABLED=true
EMOJI_AUTO_ADOPT_MIN_CONFIDENCE=0.78
# 留空/不设置表示表情池容量不受限。
# EMOJI_POOL_CAPACITY=
EMOJI_REPLACEMENT_MODE=score
EMOJI_SELECTOR_ENABLED=true
EMOJI_SELECTOR_CANDIDATE_COUNT=3
EMOJI_SELECTOR_SCORE_GAP=0.75
EMOJI_SELECTOR_TIMEOUT_SECONDS=2
EMOJI_MAX_EFFECTS_PER_REPLY=1
# 日常自发表情的目标频率；明确索要表情时不受此限制。
EMOJI_SPONTANEOUS_FREQUENCY=0.15
EMOJI_NEAR_DUPLICATE_ENABLED=true
EMOJI_NEAR_DUPLICATE_DISTANCE=6
EMOJI_SAME_EMOJI_COOLDOWN_SECONDS=300
EMOJI_SCOPE_REPEAT_COOLDOWN_SECONDS=60
EMOJI_CACHE_RETENTION_DAYS=30
EMOJI_WORKER_BATCH_SIZE=10
EMOJI_WORKER_POLL_SECONDS=2
EMOJI_WORKER_LEASE_SECONDS=120
EMOJI_WORKER_MAX_ATTEMPTS=3
EMOJI_WORKER_RETRY_DELAY_SECONDS=30
EMOJI_ANALYSIS_VERSION=emoji-v1
EMOJI_STORAGE_ROOT=data/emoji
EMOJI_PREVIEW_MAX_DIMENSION=512

# 1.8 完全本地 Genie-TTS 语音（默认关闭；模型与 GenieData 由部署者自行准备）。
SPEECH_ENABLED=false
SPEECH_PROVIDER=genie
SPEECH_SOCKET_PATH=/run/yuki-speech/genie.sock
SPEECH_ROOT=/data/speech
GENIE_DATA_DIR=/data/speech/genie_data
SPEECH_DEFAULT_PROFILE=
SPEECH_WORKER_START_TIMEOUT_SECONDS=30
SPEECH_WORKER_REQUEST_TIMEOUT_SECONDS=120
SPEECH_WORKER_IDLE_RECYCLE_SECONDS=300
SPEECH_PLANNER_ENABLED=true
SPEECH_JP_KATAKANA_ENABLED=true
SPEECH_DEFAULT_MODE=optional
SPEECH_SPLIT_SENTENCE=true
# 留空/不设置表示不增加语音专用上限。
# SPEECH_MAX_SYNTHESIS_CHARACTERS=
# SPEECH_QUEUE_MAX_PENDING=
# SPEECH_CACHE_RETENTION_HOURS=
SPEECH_PRIVATE_ENABLED=true
SPEECH_GROUP_ENABLED=true
SPEECH_AUTOMATION_ENABLED=true
SPEECH_PLUGIN_ENABLED=true
SPEECH_TEXT_FALLBACK_ENABLED=true
# 0..1，仅约束用户没有明确要求时，由 Planner 决定的日常主动语音比例。
SPEECH_SPONTANEOUS_FREQUENCY=0.15

# === 事件去重与后台清理 ===
PROCESSED_EVENT_TTL_SECONDS=86400
PROCESSED_EVENT_CLEANUP_SECONDS=3600

# 非敏感业务参数可由超级管理员通过自然语言或 /ai config 写入 SQLite 覆盖层。
# 优先级：user > group > global > 本文件 > 代码默认值；程序不会改写本文件。
# 密钥、SUPERUSERS、DATABASE_URL、监听地址与 NapCat 登录凭据不能运行时修改。
